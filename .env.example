APP_NAME=Trove
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker: host ports and the uid/gid the php container runs as.
APP_PORT=8000
VITE_PORT=5173
DOCKER_UID=1000
DOCKER_GID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is the zero-dependency default; the file lives at database/database.sqlite.
# Any Laravel-supported driver works without code changes; run that server yourself.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=trove
# DB_USERNAME=trove
# DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Optional; only used if CACHE_STORE/SESSION_DRIVER/QUEUE_CONNECTION point at redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://localhost:5173

# Registration policy. See config/trove.php.
# TROVE_REGISTRATION_MODE=open          # open | closed
# TROVE_REGISTRATION_EMAIL=optional     # optional | required | off
# TROVE_REGISTRATION_APPROVAL=false

# Media policy. See config/trove.php.
# TROVE_MEDIA_DISK=local
# TROVE_MEDIA_MAX_FILESIZE=20480        # kilobytes
# TROVE_MEDIA_DUPLICATE_POLICY=warn     # warn | reject
# TROVE_MEDIA_IMAGE_DRIVER=imagick      # imagick | gd
# TROVE_MEDIA_PRUNE_AFTER_DAYS=30
