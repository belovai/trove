includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/
        - modules/
        - database/
        - routes/

    # Level 10 is the highest level
    level: 8

    configDirectories:
        - config
        - modules/*/Config

    databaseMigrationsPath:
        - database/migrations
        - modules/*/Database/Migrations

    parseModelCastsMethod: true

    ignoreErrors:
        # This @method line is regenerated by the pre-commit ide-helper:models
        # hook from the PHP signature, which cannot express
        # list<SafetyRating>|null. The scope method's own @param does.
        -
            message: '#has PHPDoc tag @method for method withinSafetyFilter\(\)#'
            path: modules/Media/Models/Media.php

        # A transport's settings() is spread into modules/Mail/Config/settings.php
        # by MailTransportRegistry, so these env() calls are evaluated as part of
        # a config file — larastan's path-based rule cannot see that.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: modules/*/Transports/*

    excludePaths:
        - modules/*/Tests/*
